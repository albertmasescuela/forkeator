{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "forkeator",
  "title": "Forkeator",
  "type": "object",
  "properties": {
    "fileName": {
      "type": "string",
      "description": "Nombre del archivo a crear",
      "default": "nuevo-archivo.txt",
      "x-prompt": "Nombre del archivo a crear:"
    },
    "overwrite": {
      "type": "boolean",
      "description": "¿Sobrescribir si ya existe?",
      "default": false,
      "x-prompt": {
        "message": "¿Quieres sobrescribir si ya existe?",
        "type": "confirmation"
      }
    },
    "destinationPath": {
      "type": "string",
      "description": "Ruta de destino donde se copiarán los archivos",
      "default": "",
      "x-prompt": "Especifica la ruta donde quieres copiar los archivos:"
    }
  }
}
